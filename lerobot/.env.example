# ---------------------------------------------------------------------------
# Setup config. Copy to .env (git-ignored) and fill in after running
# scripts/03_hardware.sh. Variables given on the command line win over .env:
#   TASK_NAME=smartseed-grasp-white ./scripts/11_record.sh
# ---------------------------------------------------------------------------

# Hugging Face user (auto-detected from `hf auth whoami` if left empty)
HF_USER=

# Serial ports (output of `lerobot-find-port`). macOS: /dev/tty.usbmodem*, Linux: /dev/ttyACM*
FOLLOWER_PORT=/dev/tty.usbmodemCHANGE_ME1
LEADER_PORT=/dev/tty.usbmodemCHANGE_ME2

# Arm ids: they set the calibration file name.
# SAME id in calibrate / teleoperate / record / rollout, or the policy does not transfer.
# (The SmartSeed backend opens the follower as follower_01.)
FOLLOWER_ID=follower_01
LEADER_ID=leader_01

# Cameras (output of `lerobot-find-cameras opencv` or scripts/06_cameras.sh).
# CAM_TOP = fixed overview. CAM_WRIST = wrist. Leave CAM_WRIST empty if there is only one.
# Indices can change after a reboot or re-plug.
CAM_TOP=0
CAM_WRIST=1
CAM_WIDTH=640
CAM_HEIGHT=480
FPS=30

# Dataset / task (SmartSeed used one dataset per box colour: smartseed-grasp-black, -white)
TASK_NAME=smartseed-grasp-black
TASK_PROMPT="grasp the seed below the gripper"   # quotes required: it has spaces
NUM_EPISODES=100
EPISODE_TIME_S=10
RESET_TIME_S=5

# Training
POLICY_TYPE=act
DEVICE=mps               # mps (Apple Silicon), cuda, cpu
BATCH_SIZE=8             # local MPS: ~1.06 s/step at batch 8
STEPS=30000              # ~8 h on an M-series Mac
# Hugging Face Jobs hardware for cloud training (`hf jobs hardware` lists options)
JOB_TARGET=a10g-small

# Hugging Face tags for datasets and models (JSON list).
HF_TAGS='["BraboRobots","smartseed","robotekin-hackathon","lerobot","so101"]'
